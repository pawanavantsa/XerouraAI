# =============================================================================
# Xeroura CSBot — self-hosted demo (Oracle VM + Docker + Cloudflare Tunnel)
# Copy to .env and fill in values before: docker compose up -d --build
# =============================================================================

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
# Your public API hostname (no https:// prefix)
ALLOWED_HOSTS=demo-api.yourdomain.com
TRUST_X_FORWARDED_PROTO=True

# --- Public URLs (must match Cloudflare Tunnel hostnames) ---
# Used by Next.js build AND Django (webhooks / voice callbacks)
API_PUBLIC_HOST=demo-api.yourdomain.com
APP_PUBLIC_HOST=demo-app.yourdomain.com
NEXT_PUBLIC_API_URL=https://demo-api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://demo-api.yourdomain.com
PUBLIC_BASE_URL=https://demo-api.yourdomain.com

# --- Cloudflare Tunnel ---
# Zero Trust → Networks → Tunnels → your tunnel → Install connector → copy token
CLOUDFLARE_TUNNEL_TOKEN=

# --- Database (Docker Postgres — do not change host unless you know why) ---
POSTGRES_DB=support_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://postgres:change-me-strong-password@db:5432/support_agent

# --- Redis (Docker — internal only) ---
REDIS_URL=redis://redis:6379/0

# --- AI (required for bot replies) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
# Optional but recommended for real RAG search (otherwise pseudo-embeddings)
OPENAI_API_KEY=

# --- WhatsApp (optional for demo) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=my-verify-token

# --- Voice (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
VOICE_ESCALATION_FORWARD_NUMBER=

# --- Gmail (optional) ---
GOOGLE_CREDENTIALS_PATH=/app/credentials/google-credentials.json
GMAIL_WATCH_ADDRESS=support@yourdomain.com
